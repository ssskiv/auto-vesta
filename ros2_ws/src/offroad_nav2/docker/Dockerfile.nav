# Nav2 + perception image: vesta-sim (ROS 2 Humble, Webots, Nav2, robot_localization) + PyTorch/CUDA.
# Build: docker build -f Dockerfile.nav -t vesta-nav:latest .
FROM vesta-sim:latest
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-stereo-image-proc ros-humble-image-proc ros-humble-vision-msgs \
        ros-humble-nav2-mppi-controller ros-humble-nav2-collision-monitor \
        ros-humble-nav2-velocity-smoother ros-humble-nav2-behavior-tree \
        ros-humble-xacro ros-humble-urdfdom ros-humble-cv-bridge \
        python3-pytest \
    && rm -rf /var/lib/apt/lists/*
# Humble's cv_bridge is built against numpy 1.x; keep numpy<2. cu128 wheels are needed for Blackwell (sm_120).
RUN pip3 install --no-cache-dir "numpy<2" torch torchvision --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple
# torch's deps pull a setuptools that breaks Humble's ament_python/colcon builds; restore the distro version.
RUN pip3 install --no-cache-dir "setuptools==59.6.0"
