<mxfile host="app.diagrams.net"><diagram id="ml" name="offroad_nav2 ML models"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b style='font-size:16px'&gt;offroad_nav2: neural networks (three separate models, no shared weights)&lt;/b&gt;&lt;br&gt;Input: left rectified image 1280x720 -&gt; resize 640x320, ImageNet normalisation. Common encoder-decoder: EfficientNet-B0 + SceneContext + SceneNeck. Source: autoware.off-road/Models/model_components. Runtime: fp16 ONNX (normalisation fp32 + argmax inside graph), ONNX Runtime CUDA." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1700" height="50" as="geometry"/></mxCell><mxCell id="c2" value="Image&lt;br&gt;3x320x640&lt;br&gt;(RGB, normalised)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="130" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Backbone&lt;/b&gt;&lt;br&gt;EfficientNet-B0 .features (ImageNet init)&lt;br&gt;&lt;br&gt;l0: 32ch, /2 (160x320)&lt;br&gt;l2: 24ch, /4 (80x160)&lt;br&gt;l3: 40ch, /8 (40x80)&lt;br&gt;l4: 80ch, /16 (20x40)&lt;br&gt;l8: 1280ch, /32 (10x20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="140" width="170" height="190" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c2" target="c3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;SceneContext&lt;/b&gt; (shared design)&lt;br&gt;mean over HxW -&gt; MLP 1280-800-800-200 (GELU, dropout .25, sigmoid) -&gt; reshape 1x10x20 -&gt; 4 conv 3x3 (128,256,512,1280) -&gt; attention: ctx*f + f" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="210" height="130" as="geometry"/></mxCell><mxCell id="e6" value="l8 (1280x10x20)" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c3" target="c5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;SceneNeck&lt;/b&gt; (decoder)&lt;br&gt;3 x [ConvTranspose 2x2 + 1x1 skip from l4/l3/l2 + 2 conv 3x3]&lt;br&gt;1280-&amp;gt;768 (/16), 768-&amp;gt;512 (/8), 512-&amp;gt;256 (/4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="210" height="130" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c5" target="c7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="skips l4, l3, l2" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;dashed=1;" edge="1" source="c3" target="c7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;FreespaceSegHead&lt;/b&gt; (also ObjectSegHead)&lt;br&gt;ConvT + skip l0 (/2) + 2 conv, ConvT (/1) + 2 conv, conv 3x3 -&gt; logits&lt;br&gt;256-&amp;gt;128-&amp;gt;64-&amp;gt;C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="220" width="190" height="130" as="geometry"/></mxCell><mxCell id="e11" value="256x80x160" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c7" target="c10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="skip l0" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;dashed=1;" edge="1" source="c3" target="c10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;FreespaceContourHead&lt;/b&gt;&lt;br&gt;conv 1280-&amp;gt;256-&amp;gt;128 (ReLU), flatten 25600, FC 1024, FC 37x46 -&gt; view 37 rays x 46 bins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="40" width="190" height="130" as="geometry"/></mxCell><mxCell id="e14" value="l8 directly (no context, no neck)" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;dashed=1;" edge="1" source="c3" target="c13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t15" value="" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="0" width="0" height="0" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;FreespaceSeg&lt;/b&gt; output&lt;br&gt;2 x 320 x 640: non-drivable / drivable&lt;br&gt;argmax in graph -&gt; mask uint8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="220" width="230" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;FreespaceContour&lt;/b&gt; output&lt;br&gt;37 rays x 46 bins&lt;br&gt;argmax per ray -&gt; image row of the ray end; bin 45 = nothing found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="40" width="230" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;ObjectSeg&lt;/b&gt; output&lt;br&gt;5 x 320 x 640: 5 object classes&lt;br&gt;argmax in graph -&gt; class mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="230" height="70" as="geometry"/></mxCell><mxCell id="e19" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c10" target="c16" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c13" target="c17" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="(ObjectSeg weights)" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;dashed=1;" edge="1" source="c10" target="c18" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t22" value="&lt;b style='font-size:13px'&gt;Three deployed networks (each its own checkpoint and ONNX file)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="1130" height="24" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;seg.onnx&lt;/b&gt; (FreespaceSeg checkpoint)&lt;br&gt;Path: Backbone -&gt; SceneContext -&gt; SceneNeck -&gt; FreespaceSegHead&lt;br&gt;The contour head of the checkpoint is dropped.&lt;br&gt;Output: drivable mask -&gt; /perception/freespace_cloud, drivable area for Nav2 costmap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="360" height="130" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;contour.onnx&lt;/b&gt; (FreespaceContour checkpoint)&lt;br&gt;Path: Backbone (l8) -&gt; FreespaceContourHead&lt;br&gt;No context/neck/seg head: the cheapest net.&lt;br&gt;Output: 37 rays, bin 45 = clear-only edge -&gt; /perception/contour_cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="430" width="360" height="130" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;objseg.onnx&lt;/b&gt; (ObjectSeg checkpoint)&lt;br&gt;Path: full network, ObjectSegHead with 5 classes&lt;br&gt;Output: class mask -&gt; per-class clouds (obstacles, vulnerable users, ...) -&gt; BEV clustering + tracker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="430" width="360" height="130" as="geometry"/></mxCell><mxCell id="t26" value="&lt;b style='font-size:13px'&gt;From checkpoint to runtime&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="1130" height="24" as="geometry"/></mxCell><mxCell id="c27" value="PyTorch checkpoints&lt;br&gt;(/models, snapshot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="170" height="70" as="geometry"/></mxCell><mxCell id="c28" value="tools/export_onnx.py&lt;br&gt;torch_nets.py: strict load, pretrained=False, split paths; check vs PyTorch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="620" width="200" height="70" as="geometry"/></mxCell><mxCell id="c29" value="make onnx&lt;br&gt;/models/onnx/{seg,contour,objseg}.onnx&lt;br&gt;fp16 net, fp32 normalisation, argmax inside" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="620" width="200" height="70" as="geometry"/></mxCell><mxCell id="c30" value="engine.cpp (ONNX Runtime CUDA)&lt;br&gt;perception_node: 3 sessions, serial run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="620" width="220" height="70" as="geometry"/></mxCell><mxCell id="c31" value="post-processing: ground-plane RANSAC, ego-box, horizon reject, temporal filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="620" width="210" height="70" as="geometry"/></mxCell><mxCell id="e32" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c27" target="c28" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c28" target="c29" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c29" target="c30" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#000000;" edge="1" source="c30" target="c31" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>