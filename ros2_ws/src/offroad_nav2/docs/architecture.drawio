<mxfile host="app.diagrams.net"><diagram id="arch" name="offroad_nav2 architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;Auto Vesta: perception + forward-only Nav2 (Webots), package offroad_nav2&lt;/b&gt;&lt;br&gt;Boxes = ROS 2 nodes (green = C++ runtime of offroad_nav2, blue = third-party/Nav2, orange = Webots/simulator, grey = Python tools). Arrows = topics." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1500" height="40" as="geometry"/></mxCell><mxCell id="L_sim" value="Webots simulator (auto-vesta / webots_ros2_suv)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#888888;fontStyle=1;fontSize=13;startSize=26;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="330" height="640" as="geometry"/></mxCell><mxCell id="webots" value="Webots R2025a&lt;br&gt;world robocross.wbt: track, barrels (seeded), traffic light, stereo pair 0.20 m (1280x720), IMU, GPS, no lidar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="290" height="80" as="geometry"/></mxCell><mxCell id="driver" value="vesta_driver (webots_ros2_suv)&lt;br&gt;/cmd_vel (Twist) -&gt; throttle / steering; sim-time stamps; /imu/data, /joint_states, /gps/fix; optional stand-in light state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="290" height="90" as="geometry"/></mxCell><mxCell id="referee" value="referee&lt;br&gt;RoboCross scoring: touches, reversing, zones -&gt; /tmp/referee_results.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="290" height="60" as="geometry"/></mxCell><mxCell id="rsp" value="robot_state_publisher&lt;br&gt;vesta.urdf: base_link, base_footprint, stereo_*_optical_frame, imu, gps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="290" height="60" as="geometry"/></mxCell><mxCell id="barrels" value="RobocrossBarrels PROTO&lt;br&gt;/vesta/barrels_seed (Int32) reseeds the layout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="290" height="50" as="geometry"/></mxCell><mxCell id="teleport" value="/vesta/teleport (PoseStamped)&lt;br&gt;tools/teleport.py moves the car" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="290" height="45" as="geometry"/></mxCell><mxCell id="L_ster" value="Stereo depth chain" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#888888;fontStyle=1;fontSize=13;startSize=26;rounded=1;" vertex="1" parent="1"><mxGeometry x="390" y="60" width="330" height="330" as="geometry"/></mxCell><mxCell id="relay" value="stamp_relay (C++)&lt;br&gt;Webots camera stamps are wall time -&gt; restamp with sim time, pair left/right, fill CameraInfo (R, P, Tx), crop rows 340-624 for the matcher, rate limit 10 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="100" width="290" height="100" as="geometry"/></mxCell><mxCell id="sgbm" value="stereo_image_proc DisparityNode&lt;br&gt;SGBM, disparity range 96, on the cropped pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="220" width="290" height="60" as="geometry"/></mxCell><mxCell id="d2d" value="disparity_to_depth (C++)&lt;br&gt;depth = f*B/d, NaN invalid, padded back to the full 1280x720 frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="290" height="70" as="geometry"/></mxCell><mxCell id="L_loc" value="Localization (IMU + GNSS + wheel speed)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#888888;fontStyle=1;fontSize=13;startSize=26;rounded=1;" vertex="1" parent="1"><mxGeometry x="390" y="410" width="330" height="290" as="geometry"/></mxCell><mxCell id="adapter" value="sim_sensor_adapter (C++)&lt;br&gt;/gps/fix PointStamped -&gt; NavSatFix (datum, lever arm), IMU covariances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="450" width="290" height="60" as="geometry"/></mxCell><mxCell id="wheel" value="wheel_odometry (C++)&lt;br&gt;rear wheel angles -&gt; /wheel/odometry (vx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="520" width="290" height="45" as="geometry"/></mxCell><mxCell id="ekfl" value="ekf_local (robot_localization)&lt;br&gt;odom -&gt; base_link, /odometry/local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="575" width="140" height="55" as="geometry"/></mxCell><mxCell id="ekfg" value="ekf_global&lt;br&gt;map -&gt; odom, /odometry/global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="575" width="130" height="55" as="geometry"/></mxCell><mxCell id="navsat" value="navsat_transform&lt;br&gt;/gps/fix_ll -&gt; /odometry/gps (+ /fromLL service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="640" width="290" height="45" as="geometry"/></mxCell><mxCell id="L_perc" value="Perception (C++, ONNX Runtime GPU)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#888888;fontStyle=1;fontSize=13;startSize=26;rounded=1;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="440" height="430" as="geometry"/></mxCell><mxCell id="pn_pre" value="perception_node: preprocess (OpenCV)&lt;br&gt;1280x720 bgra -&gt; 640x320 RGB planar uint8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="400" height="45" as="geometry"/></mxCell><mxCell id="pn_eng" value="Engine: 3 separate networks, fp16 ONNX, one frame&lt;br&gt;FreespaceSeg (drivable) | FreespaceContour (37 rays) | ObjectSeg (5 classes)&lt;br&gt;normalisation + argmax inside the graphs (models: /models/onnx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="400" height="75" as="geometry"/></mxCell><mxCell id="pn_post" value="build_clouds (geometry + postprocess)&lt;br&gt;depth lift (5x5 median) -&gt; ground plane RANSAC -&gt; heights; ego-box filter; no points above the horizon; contour bin 45/edges only clear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="250" width="400" height="75" as="geometry"/></mxCell><mxCell id="pn_trk" value="temporal filter (2 of last 3 frames, 0.2 m cells in odom)&lt;br&gt;BEV clustering + nearest-centroid tracker for VRU / vehicles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="340" width="400" height="60" as="geometry"/></mxCell><mxCell id="pn_out" value="outputs (image stamp, optical frame)&lt;br&gt;/perception/points/{geometric, nondrivable, clear, vru, vehicle, manmade, natural, contour_*}&lt;br&gt;/perception/objects, /perception/latency_ms, /perception/seg_vis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="410" width="400" height="65" as="geometry"/></mxCell><mxCell id="tl" value="traffic_light_node (C++)&lt;br&gt;/perception/traffic_light (stand-in only, no model yet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="505" width="215" height="55" as="geometry"/></mxCell><mxCell id="wall" value="stop_wall_node (C++)&lt;br&gt;virtual wall before the stop line -&gt; /perception/stop_wall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="985" y="505" width="215" height="55" as="geometry"/></mxCell><mxCell id="onnx" value="make onnx: tools/export_onnx.py&lt;br&gt;checkpoints (*.pth) -&gt; ONNX (offline, PyTorch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="585" width="440" height="50" as="geometry"/></mxCell><mxCell id="L_nav" value="Nav2 (forward-only) + vehicle interface" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#888888;fontStyle=1;fontSize=13;startSize=26;rounded=1;" vertex="1" parent="1"><mxGeometry x="1240" y="60" width="420" height="640" as="geometry"/></mxCell><mxCell id="map" value="map_server&lt;br&gt;static robocross map (fence = occupied)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="100" width="380" height="40" as="geometry"/></mxCell><mxCell id="gcm" value="global_costmap: static + geometric + VRU + vehicle layers + inflation&lt;br&gt;local_costmap (40x40 m rolling): + semantic layer (non-drivable, natural, man-made); every layer also gets the &quot;clear&quot; cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="150" width="380" height="75" as="geometry"/></mxCell><mxCell id="plan" value="planner_server&lt;br&gt;Smac Hybrid-A*, DUBIN (no reverse), R_min 4.0 m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="235" width="185" height="55" as="geometry"/></mxCell><mxCell id="ctrl" value="controller_server&lt;br&gt;Regulated Pure Pursuit, 3 m/s, no reversing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1455" y="235" width="185" height="55" as="geometry"/></mxCell><mxCell id="bt" value="bt_navigator + behavior_server + waypoint_follower&lt;br&gt;BT: replan, keep last path if replan fails; recoveries = clear costmaps + wait (no BackUp / Spin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="380" height="60" as="geometry"/></mxCell><mxCell id="smooth" value="velocity_smoother&lt;br&gt;/cmd_vel_nav_raw -&gt; /cmd_vel_smoothed (min vx = 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="375" width="380" height="45" as="geometry"/></mxCell><mxCell id="cm" value="collision_monitor&lt;br&gt;last-resort STOP zone (3.75-4.7 m ahead, car width) + SLOW zone; sources: geometric cloud + stop_wall&lt;br&gt;-&gt; /cmd_vel_nav" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="430" width="380" height="65" as="geometry"/></mxCell><mxCell id="zc" value="zero_clamp_relay (C++)&lt;br&gt;linear.x = max(linear.x, 0), 0.3 s watchdog -&gt; /cmd_vel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="510" width="380" height="50" as="geometry"/></mxCell><mxCell id="dbw" value="cmd_to_ackermann (C++) + DbwAdapter (logging stub)&lt;br&gt;real-car path only: delta = atan(L*omega/v); OSCC adapter = TODO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="575" width="380" height="55" as="geometry"/></mxCell><mxCell id="tools" value="operator tools (Python): nav_goal, gps_route (/fromLL -&gt; FollowWaypoints), lap_mission (live waypoint snapping), tl_test, rviz2 (ros2_ws/src/rviz/default.rviz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="380" height="50" as="geometry"/></mxCell><mxCell id="e2" value="/stereo_raw/{left,right}/image_color + camera_info (wall-clock stamps)" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#d79b00;" edge="1" parent="1" source="webots" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="/stereo_crop/{left,right}/image_rect + camera_info" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="relay" target="sgbm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="/stereo/disparity" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="sgbm" target="d2d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="/stereo/left/image_rect (sim stamp), /stereo/left/camera_info" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="relay" target="pn_pre"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="/stereo/depth (32FC1, m)" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="d2d" target="pn_post"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="CHW uint8" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="pn_pre" target="pn_eng"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="seg, contour, objseg class maps (uint8)" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="pn_eng" target="pn_post"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="clouds (optical frame)" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="pn_post" target="pn_trk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="filtered clouds, objects" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="pn_trk" target="pn_out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="seg/contour/objseg.onnx" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="onnx" target="pn_eng"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="/imu/data, /gps/fix" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="driver" target="adapter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="/joint_states" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="driver" target="wheel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="/imu/data_cov" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="adapter" target="ekfl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="/wheel/odometry" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="wheel" target="ekfl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="/gps/fix_ll, /imu/data_cov" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="adapter" target="navsat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="/odometry/local" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ekfl" target="ekfg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="/odometry/gps" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="navsat" target="ekfg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="/odometry/global" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="ekfg" target="navsat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="static TF" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="rsp" target="ekfl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="/imu/data -&gt; up vector (ground-plane prior)" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="driver" target="pn_post"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="/standin/traffic_light_state (world truth)" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="driver" target="tl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="/perception/traffic_light" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="tl" target="wall"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="geometric / VRU / vehicle / semantic / clear clouds" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="pn_out" target="gcm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="/map" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="map" target="gcm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="map -&gt; odom -&gt; base_link (TF), /odometry/local" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ekfg" target="bt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="costmaps" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="gcm" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="costmaps" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="gcm" target="ctrl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="ComputePathToPose" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="bt" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="FollowPath" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="bt" target="ctrl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="/cmd_vel_nav_raw" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ctrl" target="smooth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="/cmd_vel_smoothed" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="smooth" target="cm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="/perception/points/geometric" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="pn_out" target="cm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="/perception/stop_wall" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="wall" target="cm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="/cmd_vel_nav" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="cm" target="zc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="/cmd_vel (Twist, forward only)" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1" source="zc" target="driver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="NavigateToPose / FollowWaypoints actions" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="tools" target="bt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="teleport" target="driver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="barrels" target="webots"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e40" value="car pose (supervisor)" style="endArrow=classic;html=1;rounded=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="driver" target="referee"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>