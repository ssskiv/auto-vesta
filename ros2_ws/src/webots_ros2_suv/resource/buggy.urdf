<?xml version="1.0"?>
<!-- Buggy geometry and sensor mounts match Buggy.proto / robocross_buggy.wbt. -->
<robot name="buggy">
    <link name="base_link" />
    <link name="body_link">
        <visual>
            <origin xyz="0.9 0 0.16" />
            <geometry>
                <box size="2.17 1.1 0.44" />
            </geometry>
        </visual>
    </link>
    <joint name="body_joint" type="fixed">
        <parent link="base_link" />
        <child link="body_link" />
    </joint>
    <link name="front_left_steer_link" />
    <joint name="front_left_steer_joint" type="revolute">
        <parent link="base_link" />
        <child link="front_left_steer_link" />
        <origin xyz="1.799622521265 0.619203986095 0" />
        <axis xyz="0 0 1" />
        <limit lower="-0.6" upper="0.6" effort="100" velocity="10" />
    </joint>
    <link name="front_left_wheel_link">
        <visual>
            <origin rpy="1.5708 0 0" />
            <geometry>
                <cylinder radius="0.29155" length="0.175" />
            </geometry>
        </visual>
    </link>
    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="front_left_steer_link" />
        <child link="front_left_wheel_link" />
        <axis xyz="0 1 0" />
    </joint>
    <link name="front_right_steer_link" />
    <joint name="front_right_steer_joint" type="revolute">
        <parent link="base_link" />
        <child link="front_right_steer_link" />
        <origin xyz="1.799622521265 -0.619203986095 0" />
        <axis xyz="0 0 1" />
        <limit lower="-0.6" upper="0.6" effort="100" velocity="10" />
    </joint>
    <link name="front_right_wheel_link">
        <visual>
            <origin rpy="1.5708 0 0" />
            <geometry>
                <cylinder radius="0.29155" length="0.175" />
            </geometry>
        </visual>
    </link>
    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="front_right_steer_link" />
        <child link="front_right_wheel_link" />
        <axis xyz="0 1 0" />
    </joint>
    <link name="rear_left_wheel_link">
        <visual>
            <origin rpy="1.5708 0 0" />
            <geometry>
                <cylinder radius="0.29155" length="0.175" />
            </geometry>
        </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="rear_left_wheel_link" />
        <origin xyz="0 0.618806234333 0" />
        <axis xyz="0 1 0" />
    </joint>
    <link name="rear_right_wheel_link">
        <visual>
            <origin rpy="1.5708 0 0" />
            <geometry>
                <cylinder radius="0.29155" length="0.175" />
            </geometry>
        </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="rear_right_wheel_link" />
        <origin xyz="0 -0.618806234333 0" />
        <axis xyz="0 1 0" />
    </joint>
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.0517" length="0.0717" />
            </geometry>
        </visual>
    </link>
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="1.79 0 0.52" rpy="0 0 0" />
    </joint>
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.0574 0.0428 0.0235" />
            </geometry>
        </visual>
    </link>
    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0.96 0 0.03" rpy="0 0 0" />
    </joint>
    <link name="gps_link">
        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.015" />
            </geometry>
        </visual>
    </link>
    <joint name="gps_joint" type="fixed">
        <parent link="base_link" />
        <child link="gps_link" />
        <origin xyz="-0.05 0 0.39" rpy="0 0 0" />
    </joint>
    <link name="base_footprint" />
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link" />
        <child link="base_footprint" />
        <origin xyz="0 0 -0.29155" rpy="0 0 0" />
    </joint>
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.04 0.03 0.03" />
            </geometry>
        </visual>
    </link>
    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="1.94 0 0.28" rpy="0 0 0" />
    </joint>
    <webots>
        <device reference="gps" type="GPS">
            <ros>
                <enabled>true</enabled>
                <alwaysOn>true</alwaysOn>
                <updateRate>10</updateRate>
                <topicName>/gps/fix</topicName>
                <frameName>gps_link</frameName>
            </ros>
        </device>
        <device reference="rgb_camera" type="Camera">
            <ros>
                <enabled>true</enabled>
                <alwaysOn>true</alwaysOn>
                <updateRate>30</updateRate>
                <topicName>/camera/image_raw</topicName>
                <frameName>camera_link</frameName>
            </ros>
        </device>
        <plugin type="webots_ros2_driver::Ros2IMU">
            <enabled>true</enabled>
            <alwaysOn>true</alwaysOn>
            <updateRate>100</updateRate>
            <topicName>/vesta/imu/data</topicName>
            <frameName>imu_link</frameName>
            <inertialUnitName>imu</inertialUnitName>
            <gyroName>imu_gyro</gyroName>
            <accelerometerName>imu_accelerometer</accelerometerName>
        </plugin>
        <plugin type="webots_ros2_suv.vesta_driver.VestaDriver">
            <wheelbase>1.799622521265</wheelbase>
        </plugin>
    </webots>
</robot>
