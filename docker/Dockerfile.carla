# Vesta sim image + CARLA Python API + official carla-ros-bridge (ROS 2 Humble).
# Built on top of the Webots image: ./start.sh builds vesta-sim first.
ARG BASE=vesta-sim:latest
FROM ${BASE}

ARG DEBIAN_FRONTEND=noninteractive
# Must equal the version of the carlasim server image (compose.carla.yml, CARLA_VERSION).
ARG CARLA_VERSION=0.9.15
ARG ROS_BRIDGE_REF=master

# The CARLA wheel on PyPI supports Python 3.10 (Humble) from 0.9.14.
RUN pip3 install --no-cache-dir "carla==${CARLA_VERSION}" "numpy<2" pygame transforms3d simple-pid

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-derived-object-msgs ros-humble-ackermann-msgs \
        ros-humble-cv-bridge ros-humble-pcl-conversions ros-humble-tf-transformations \
        python3-networkx \
    && rm -rf /var/lib/apt/lists/*

# carla-ros-bridge has no apt package for Humble: build it from source into /opt.
RUN mkdir -p /opt/carla_ros_ws/src && cd /opt/carla_ros_ws/src && \
    git clone --depth 1 --branch "${ROS_BRIDGE_REF}" --recurse-submodules --shallow-submodules \
        https://github.com/carla-simulator/ros-bridge.git && \
    # ros-bridge master pins the CARLA client to 0.9.13 and exits on any other version.
    sed -i "s/CARLA_VERSION = .*/CARLA_VERSION = '${CARLA_VERSION}'/" \
        ros-bridge/carla_ros_bridge/src/carla_ros_bridge/bridge.py && \
    cd /opt/carla_ros_ws && \
    source /opt/ros/humble/setup.bash && \
    (rosdep init 2>/dev/null || true) && rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y || true && \
    colcon build --symlink-install \
        --packages-up-to carla_ros_bridge carla_spawn_objects carla_msgs && \
    rm -rf /var/lib/apt/lists/*

RUN echo '[ -f /opt/carla_ros_ws/install/setup.bash ] && source /opt/carla_ros_ws/install/setup.bash' \
        >> /root/.bashrc

ENV CARLA_HOST=carlasim
ENV CARLA_PORT=2000

COPY entrypoint.carla.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
